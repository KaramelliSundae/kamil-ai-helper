# The document sandbox when this machine can run Firecracker microVMs: install.sh enables this instead of
# ai-ders-docparse.socket whenever /dev/kvm, firecracker and kernel-devel are present and the image builds
# (deploy/linux/firecracker/build-image.sh, into /var/lib/ai-ders-firecracker), and points
# DOC_PARSER_SOCKET here.
[Unit]
Description=AI Ders document sandbox socket (Firecracker)

# Without these the socket would still listen, and every document handed to it would fail to boot and be
# stored as unreadable. Not starting at all instead makes the watcher's connect fail, which it already
# treats as an outage: the poll fails and is retried, and nothing is lost.
ConditionPathExists=/dev/kvm
ConditionPathExists=/usr/bin/firecracker
ConditionPathExists=/var/lib/ai-ders-firecracker/vmlinux
ConditionPathExists=/var/lib/ai-ders-firecracker/initramfs.cpio.gz

[Socket]
ListenStream=/run/ai-ders-docparse-fc.sock
# Only the ai-ders user (the watcher) may hand it a document.
SocketUser=ai-ders
SocketGroup=ai-ders
SocketMode=0600
# Accept=yes is what makes this instantiate ai-ders-docparse-fc@.service (a template) per connection
# rather than systemd looking for a plain ai-ders-docparse-fc.service, which doesn't exist.
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
