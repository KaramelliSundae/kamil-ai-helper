[Unit]
Description=AI Ders watcher: Canvas and school mail
Wants=network-online.target ai-ders-mailparse.socket ai-ders-docparse.socket
After=network-online.target ai-ders-mailparse.socket ai-ders-docparse.socket

[Service]
Type=oneshot
User=ai-ders
Group=ai-ders
StateDirectory=ai-ders
StateDirectoryMode=0700
EnvironmentFile=/etc/ai-ders/env
Environment=PYTHONUNBUFFERED=1
LoadCredentialEncrypted=canvas_token:/etc/ai-ders/creds/canvas_token.cred
LoadCredentialEncrypted=mail_password:/etc/ai-ders/creds/mail_password.cred
ExecStart=/opt/ai-ders/.venv/bin/ai-ders poll
TimeoutStartSec=300

# Gives way to everything else on the machine: lowest priority, a small memory ceiling, no GPU.
Nice=15
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=512M
PrivateDevices=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# Extra walls: no kernel, clock or other processes in view, no writable-executable memory, and only
# ordinary service syscalls.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateIPC=yes
KeyringMode=private
UMask=0077
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @module @raw-io @reboot @swap @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
