[Unit]
Description=AI Ders watcher: Canvas and school mail
Wants=network-online.target
# No Wants= on the parser sockets: install.sh enables whichever pair this machine uses (the Firecracker
# ones, or the systemd-sandbox ones without KVM), and Wants= here would start the other pair too on
# every poll. After= on a socket that isn't being started is simply ignored.
After=network-online.target ai-ders-mailparse.socket ai-ders-docparse.socket ai-ders-mailparse-fc.socket ai-ders-docparse-fc.socket

[Service]
Type=oneshot
User=ai-ders
Group=ai-ders
StateDirectory=ai-ders
StateDirectoryMode=0700
EnvironmentFile=/etc/ai-ders/env
Environment=PYTHONUNBUFFERED=1
LoadCredentialEncrypted=canvas_token:/etc/ai-ders/creds/canvas_token.cred
LoadCredentialEncrypted=mail_password:/etc/ai-ders/creds/mail_password.cred
ExecStart=/opt/ai-ders/.venv/bin/ai-ders poll
TimeoutStartSec=300

# Gives way to everything else on the machine: lowest priority, a small memory ceiling, no GPU.
Nice=15
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=512M
TasksMax=32
PrivateDevices=yes

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
# This process holds a decrypted Canvas token and mail password in memory; a core dump on crash
# would otherwise write them to disk in the clear.
LimitCORE=0
# Nothing in ai_ders ever execs anything (tests/test_boundaries.py checks tools.py specifically);
# this backs that at the OS level too, for the whole poll path, not just the tool-calling one.
NoExecPaths=/
ExecPaths=/opt/ai-ders /usr/lib64 /usr/lib

# Extra walls: no kernel, clock or other processes in view, no writable-executable memory, and only
# ordinary service syscalls.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
PrivateIPC=yes
KeyringMode=private
UMask=0077
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @module @raw-io @reboot @swap @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
