# Server settings. Installed to /etc/ai-ders/env; edit there, then restart: sudo systemctl restart ai-ders-api
# Secrets never go here: use deploy/linux/set-secrets.sh (Canvas token, mail password) and the app's
# Settings screen or deploy/linux/connect-gemini.sh (Gemini key).
# Comments must be on their own line: systemd's EnvironmentFile does not strip trailing comments.

# Your school's Canvas, for example https://canvas.youruni.edu
CANVAS_URL=

# School mail over IMAP (read-only). Leave IMAP_HOST empty to run without mail.
IMAP_HOST=
IMAP_PORT=993
# Your school mail address, for example name.surname@youruni.edu
MAIL_USER=
# Used to sign mail drafts and to greet you in the app.
STUDENT_NAME=
# Sends approved drafts and the optional daily digest. Leave empty to turn sending off.
# 465 is TLS from the first byte (preferred); 587 works too and must offer STARTTLS.
SMTP_HOST=
SMTP_PORT=465
# Where the daily digest goes, if you want one by mail. Use a different address from MAIL_USER.
NOTIFY_EMAIL=
# The address of your school's webmail, for the app's "open in webmail" button. Optional.
WEBMAIL_URL=
# Addresses under this domain count as your school's. Defaults to the domain of MAIL_USER.
SCHOOL_DOMAIN=

# Gemini model. The key itself is entered in the app (Settings) or with connect-gemini.sh.
GEMINI_MODEL=gemini-3.8-flash
# Optional local model: any OpenAI-compatible server on this machine (llama.cpp's llama-server,
# Ollama, LM Studio), for example http://127.0.0.1:8080. Empty: Gemini only.
LOCAL_LLM_URL=
# Optional: a gate that lends the GPU to another program and stops the local model meanwhile.
GPU_GATE_URL=

TIMEZONE=Europe/Istanbul
# Hours before a deadline. The last one at or under CRITICAL_HOURS ignores quiet hours.
REMINDER_HOURS=72,24,3
CRITICAL_HOURS=3
# Local hours. Only critical events are sent between these.
QUIET_START=0
QUIET_END=8
# Keep a desktop or laptop server from sleeping (yes/no).
KEEP_AWAKE=no
